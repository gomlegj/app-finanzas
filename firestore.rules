rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      function perfilValido() {
        let d = request.resource.data;
        return (!('moneda' in d) || d.moneda in ['COP', 'USD', 'EUR', 'MXN', 'PEN', 'CLP', 'ARS'])
          && (!('diasPago' in d) || (
            d.diasPago is list && d.diasPago.size() == 2
            && d.diasPago[0] is int && d.diasPago[1] is int
            && d.diasPago[0] >= 1 && d.diasPago[0] <= 31
            && d.diasPago[1] >= 1 && d.diasPago[1] <= 31
            && d.diasPago[0] <= 27
            && d.diasPago[1] - d.diasPago[0] >= 2));
      }

      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && perfilValido();

      match /categorias/{id} {
        function categoriaValida() {
          let d = request.resource.data;
          return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
            && d.tipo in ['gasto', 'ingreso']
            && d.icono is string
            && d.color is string
            && d.orden is int
            && d.sistema is bool
            && d.archivada is bool;
        }

        allow read: if esDueno(uid);
        allow create: if esDueno(uid) && categoriaValida();
        allow update: if esDueno(uid) && categoriaValida()
          && request.resource.data.sistema == resource.data.sistema
          && !(resource.data.sistema && request.resource.data.archivada);
        allow delete: if false;
      }

      match /movimientos/{id} {
        function origenValido(d) {
          // Un pago (de fijo, deuda o meta) siempre es gasto.
          return !('origen' in d) || (
            d.tipo == 'gasto'
            && d.origen is map
            && d.origen.keys().hasOnly(['tipo', 'id'])
            && d.origen.tipo in ['fijo', 'deuda', 'meta']
            && d.origen.id is string && d.origen.id.size() > 0);
        }

        function movimientoValido() {
          let d = request.resource.data;
          return d.tipo in ['gasto', 'ingreso']
            && d.monto is int && d.monto > 0
            && d.categoriaId is string && d.categoriaId.size() > 0
            && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (!('nota' in d) || (d.nota is string && d.nota.size() <= 200))
            && origenValido(d);
        }

        allow read, delete: if esDueno(uid);
        allow create: if esDueno(uid) && movimientoValido();
        // El origen une el pago con su fijo/deuda/meta: no se cambia al editar.
        allow update: if esDueno(uid) && movimientoValido()
          && request.resource.data.get('origen', null) == resource.data.get('origen', null);
      }

      match /fijos/{id} {
        function fijoValido() {
          let d = request.resource.data;
          return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
            && d.monto is int && d.monto > 0
            && d.categoriaId is string && d.categoriaId.size() > 0
            && d.activo is bool
            && ((d.frecuencia == 'mensual' && 'quincena' in d && d.quincena is int && d.quincena in [1, 2])
              || (d.frecuencia == 'quincenal' && !('quincena' in d)));
        }

        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && fijoValido();
      }
    }
  }
}
