rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      function perfilValido() {
        let d = request.resource.data;
        return (!('moneda' in d) || d.moneda in ['COP', 'USD', 'EUR', 'MXN', 'PEN', 'CLP', 'ARS'])
          && (!('diasPago' in d) || (
            d.diasPago is list && d.diasPago.size() == 2
            && d.diasPago[0] is int && d.diasPago[1] is int
            && d.diasPago[0] >= 1 && d.diasPago[0] <= 31
            && d.diasPago[1] >= 1 && d.diasPago[1] <= 31
            && d.diasPago[0] <= 27
            && d.diasPago[1] - d.diasPago[0] >= 2));
      }

      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && perfilValido();

      match /categorias/{id} {
        function categoriaValida() {
          let d = request.resource.data;
          return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
            && d.tipo in ['gasto', 'ingreso']
            && d.icono is string
            && d.color is string
            && d.orden is int
            && d.sistema is bool
            && d.archivada is bool;
        }

        allow read: if esDueno(uid);
        allow create: if esDueno(uid) && categoriaValida();
        allow update: if esDueno(uid) && categoriaValida()
          && request.resource.data.sistema == resource.data.sistema
          && !(resource.data.sistema && request.resource.data.archivada);
        allow delete: if false;
      }

      match /movimientos/{id} {
        function origenValido(d) {
          // Un pago (fijo o deuda) siempre es gasto; una meta admite abonos (gasto) y retiros (ingreso).
          return !('origen' in d) || (
            d.origen is map
            && d.origen.keys().hasOnly(['tipo', 'id'])
            && d.origen.tipo in ['fijo', 'deuda', 'meta']
            && d.origen.id is string && d.origen.id.size() > 0
            && (d.tipo == 'gasto' || d.origen.tipo == 'meta'));
        }

        function movimientoValido() {
          let d = request.resource.data;
          return d.tipo in ['gasto', 'ingreso']
            && d.monto is int && d.monto > 0
            && d.categoriaId is string && d.categoriaId.size() > 0
            && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (!('nota' in d) || (d.nota is string && d.nota.size() <= 200))
            && origenValido(d);
        }

        allow read, delete: if esDueno(uid);
        allow create: if esDueno(uid) && movimientoValido();
        // El origen une el pago con su fijo/deuda/meta: no se cambia al editar.
        allow update: if esDueno(uid) && movimientoValido()
          && request.resource.data.get('origen', null) == resource.data.get('origen', null);
      }

      match /fijos/{id} {
        function fijoValido() {
          let d = request.resource.data;
          return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
            && d.monto is int && d.monto > 0
            && d.categoriaId is string && d.categoriaId.size() > 0
            && d.activo is bool
            && ((d.frecuencia == 'mensual' && 'quincena' in d && d.quincena is int && d.quincena in [1, 2])
              || (d.frecuencia == 'quincenal' && !('quincena' in d)))
            && (!('diaPago' in d)
              || (d.frecuencia == 'mensual' && d.diaPago is int && d.diaPago >= 1 && d.diaPago <= 31));
        }

        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && fijoValido();
      }

      match /metas/{id} {
        function metaValida() {
          let d = request.resource.data;
          return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
            && d.icono is string && d.color is string
            && d.objetivo is int && d.objetivo > 0
            && d.ahorroInicial is int && d.ahorroInicial >= 0
            && d.archivada is bool
            && ((d.modo == 'fecha' && 'fechaObjetivo' in d && d.fechaObjetivo is string
                  && d.fechaObjetivo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && !('cuotaQuincenal' in d))
              || (d.modo == 'cuota' && 'cuotaQuincenal' in d && d.cuotaQuincenal is int && d.cuotaQuincenal > 0
                  && !('fechaObjetivo' in d)));
        }

        allow read: if esDueno(uid);
        allow create, update: if esDueno(uid) && metaValida();
        // Se archivan: borrar dejaría abonos sin su meta.
        allow delete: if false;
      }

      match /deudas/{id} {
        function deudaValida() {
          let d = request.resource.data;
          return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
            && d.tipo in ['tarjeta', 'prestamo', 'otro']
            && d.saldoBase is int && d.saldoBase >= 0
            && d.saldoBaseEn is timestamp
            && d.cuota is int && d.cuota > 0
            && d.diaPago is int && d.diaPago >= 1 && d.diaPago <= 31
            && d.archivada is bool;
        }

        allow read: if esDueno(uid);
        // El momento del saldo es la hora del servidor: se compara con la de registro de los pagos.
        allow create: if esDueno(uid) && deudaValida() && request.resource.data.saldoBaseEn == request.time;
        allow update: if esDueno(uid) && deudaValida()
          && (request.resource.data.saldoBaseEn == resource.data.saldoBaseEn
            || request.resource.data.saldoBaseEn == request.time);
        // Se archivan: borrar dejaría pagos sin su deuda.
        allow delete: if false;
      }
    }
  }
}
